rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Base segura para o Rise Flow:
    // somente usuários autenticados conseguem ler/escrever.
    //
    // Os usuários devem ser criados/gerenciados no Firebase Authentication.
    // Em uma próxima versão podemos adicionar cargos/permissões por usuário.

    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    match /members/{memberId} {
      allow read, write: if request.auth != null;
    }
  }
}
